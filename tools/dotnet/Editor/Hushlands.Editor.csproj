<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile check for Hushlands.Editor against Unity 6 engine refs + verified UnityEditor/package stubs. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Hushlands.Editor</AssemblyName>
    <NoWarn>$(NoWarn);CS1701;CS1702</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/_Hushlands/Code/Editor/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Hushlands.Core.csproj" />
    <ProjectReference Include="../Runtime/Hushlands.Runtime.csproj" />
    <ProjectReference Include="../Stubs/Hushlands.UnityPackageStubs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(UNITY_REFS)/*.dll" Private="false" />
  </ItemGroup>
</Project>
